# Installed on the campus laptop as /etc/hpc-relay/campus.env
# Mode 644. Do not put the portal password or any private key in this file.

CAMPUS_USER=campus
WIFI_IFACE=wlan0
WIFI_CONNECTION='Campus Wi-Fi'
# Optional override if the profile's SSID cannot be read from NetworkManager.
# WIFI_SSID='Campus Wi-Fi'
RELAY_HOST=203.0.113.10
RELAY_USER=tunnel
RELAY_PORT=2222
TUNNEL_KEY=/home/campus/.ssh/ec2_tunnel

# Optional helper for the NITJ/Sophos mode-451 login flow.
# Leave disabled for portal-free networks or until your own adapter is ready.
PORTAL_ENABLED=0
PORTAL_GATEWAY=192.0.2.1
PORTAL_TLS_VERIFY=1
# For a private CA, install its certificate and set an absolute path here.
# PORTAL_CA_FILE=/etc/nitj-portal/ca.pem
